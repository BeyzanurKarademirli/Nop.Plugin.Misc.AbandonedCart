<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Copyright>Copyright © Beyzanur</Copyright>
    <Company>Beyzanur</Company>
    <Authors>Beyzanur</Authors>
    <OutputPath>..\..\Presentation\Nop.Web\Plugins\Misc.AbandonedCart</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="plugin.json" />
    <None Remove="Views\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Views\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Presentation\Nop.Web.Framework\Nop.Web.Framework.csproj" />
    <ClearPluginAssemblies Include="$(MSBuildProjectDirectory)\..\..\Build\ClearPluginAssemblies.proj" />
  </ItemGroup>

  <Target Name="CopyPluginFiles" AfterTargets="Build">
    <Copy SourceFiles="plugin.json" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" />
    <ItemGroup>
      <PluginViews Include="Views\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginViews)" DestinationFolder="$(OutDir)\Views\%(RecursiveDir)" SkipUnchangedFiles="false" />
  </Target>

  <!-- This target executes after building the plugin project -->
  <Target Name="NopTarget" AfterTargets="Build">
    <!-- Delete unnecessary libraries from the output directory -->
    <MSBuild Projects="@(ClearPluginAssemblies)" Properties="PluginPath=$(MSBuildProjectDirectory)\$(OutputPath)" Targets="NopClear" />
  </Target>

</Project>
